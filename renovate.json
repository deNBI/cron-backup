{
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "updateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "updateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "updateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch"
      ]
    },
    {
      "addLabels": [
        "pin"
      ],
      "enabled": false,
      "matchUpdateTypes": [
        "pin"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "baseBranches": [
    "dev"
  ],
  "reviewers": [
    "team:portal-dev"
  ],
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "team:portal-dev"
  ],
  "branchPrefix": "deps/",
  "bumpVersion": "minor",
  "rebaseWhen": "behind-base-branch",
  "commitBodyTable": "true",
  "commitMessagePrefix": "feat(Dependencies):"
}